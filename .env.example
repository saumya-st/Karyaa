# Copy this file to .env and fill in the values. Never commit .env.

# --- Database (Neon Postgres) ---
# Pooled connection string used by the app at runtime. Neon dashboard -> Connection Details -> "Pooled connection".
DATABASE_URL=
# Direct (non-pooled) connection string used by Prisma CLI for `prisma db push` / migrations. Same dashboard, "Direct connection".
DIRECT_URL=

# --- Auth (NextAuth v5) ---
# Secret used to sign JWT session cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET=
# Canonical URL of the app, used to build OAuth callback URLs. Use your deployment URL in production.
AUTH_URL=http://localhost:3000
# Set to true when running behind a proxy or on a host (Vercel, Docker) so NextAuth trusts the Host header.
AUTH_TRUST_HOST=true

# --- App ---
# Public base URL used to build invite links in emails and the invite dialog.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (Resend) ---
# API key from https://resend.com/api-keys. Optional: without it, email invites return an error but link invites still work.
RESEND_API_KEY=

# --- Google OAuth + Calendar ---
# OAuth 2.0 client from Google Cloud Console -> APIs & Services -> Credentials.
# Add <AUTH_URL>/api/auth/callback/google as an authorized redirect URI and enable the Google Calendar API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
